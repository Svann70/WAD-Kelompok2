PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here

# Opsi 1: Menggunakan Connection String / URI Supabase (Direkomendasikan)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Contoh (Direct connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Atau contoh (Transaction Pooler - port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Opsi 2: Menggunakan parameter terpisah (Fallback)
DB_HOST=db.[PROJECT-REF].supabase.co
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=postgres
DB_PORT=5432
DB_SSLMODE=require
